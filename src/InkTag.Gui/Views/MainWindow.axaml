<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InkTag.Gui.ViewModels"
        xmlns:conv="using:InkTag.Gui.Converters"
        x:Class="InkTag.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="InkTag Desktop"
        Icon="/Assets/inktag.ico"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

  <Window.Resources>
    <conv:IsDirtyToBrushConverter x:Key="IsDirtyToBrushConverter"/>
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}" Command="{Binding SaveAllCommand}"/>
    <KeyBinding Gesture="{OnPlatform 'Ctrl+A', macOS='Cmd+A'}" Command="{Binding SelectAllCommand}"/>
  </Window.KeyBindings>

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open Folder..." Gesture="{OnPlatform 'Ctrl+O', macOS='Cmd+O'}" Click="NativeOpenFolder_Click"/>
          <NativeMenuItem Header="Save All" Gesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}" Click="NativeSaveAll_Click"/>
          <NativeMenuItem Header="Export CSV..." Click="NativeExportCsv_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Exit" Gesture="{OnPlatform 'Ctrl+Q', macOS='Cmd+Q'}" Click="NativeExit_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenu>
          <NativeMenuItem Header="Select All" Gesture="{OnPlatform 'Ctrl+A', macOS='Cmd+A'}" Click="NativeSelectAll_Click"/>
          <NativeMenuItem Header="Clear Selection" Click="NativeClearSelection_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Scan Recursively" ToggleType="CheckBox" IsChecked="{Binding IsRecursive}"/>
          <NativeMenuItem Header="Inspector Panel" ToggleType="CheckBox" IsChecked="{Binding IsInspectorVisible}"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Theme">
            <NativeMenu>
              <NativeMenuItem Header="System Default" ToggleType="Radio" IsChecked="{Binding IsThemeSystem}" Click="NativeThemeSystem_Click"/>
              <NativeMenuItem Header="Dark Mode" ToggleType="Radio" IsChecked="{Binding IsThemeDark}" Click="NativeThemeDark_Click"/>
              <NativeMenuItem Header="Light Mode" ToggleType="Radio" IsChecked="{Binding IsThemeLight}" Click="NativeThemeLight_Click"/>
            </NativeMenu>
          </NativeMenuItem>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Enable Verbose / Debug Logging" ToggleType="CheckBox" Click="NativeToggleDebugLogging_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Refresh Grid" Gesture="{OnPlatform 'F5', macOS='Cmd+R'}" Click="NativeRefreshGrid_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Tools">
        <NativeMenu>
          <NativeMenuItem Header="Auto-Tag Metadata (ComicVine)..." Click="NativeScrapeMetadata_Click"/>
          <NativeMenuItem Header="Series Search Wizard..." Click="NativeSeriesSearchWizard_Click"/>
          <NativeMenuItem Header="Bulk Auto-Tag Queue..." Click="NativeBulkScrapeQueue_Click"/>
          <NativeMenuItem Header="Infer Metadata from Path / Filename" Click="NativeInferMetadataFromFilenames_Click"/>
          <NativeMenuItem Header="Rename File(s) from Metadata..." Click="NativeRenameFiles_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Sync to Komga Server" Click="NativeSyncToKomga_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Open Logs Directory" Click="NativeOpenLogs_Click"/>
          <NativeMenuItem Header="Settings..." Gesture="{OnPlatform 'Ctrl+,', macOS='Cmd+,'}" Click="NativeSettings_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="Check for Updates" Click="NativeCheckForUpdates_Click"/>
          <NativeMenuItem Header="Install &amp; Restart Update" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="About InkTag Desktop" Click="NativeAbout_Click"/>
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid RowDefinitions="Auto, Auto, *, Auto">
    
    <!-- Top MenuBar (Hidden on macOS so only the system macOS menu bar is used) -->
    <Menu Grid.Row="0" IsVisible="{OnPlatform macOS=False, Default=True}" Background="{DynamicResource AppHeaderBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <!-- File Menu -->
      <MenuItem Header="_File">
        <MenuItem Header="_Open Folder..." InputGesture="Ctrl+O" Click="OpenFolder_Click"/>
        <MenuItem Header="_Save All" InputGesture="Ctrl+S" Command="{Binding SaveAllCommand}"/>
        <MenuItem Header="_Export CSV..." Click="ExportCsv_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Click="Exit_Click"/>
      </MenuItem>

      <!-- Edit Menu -->
      <MenuItem Header="_Edit">
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="SelectAll_Click"/>
        <MenuItem Header="_Clear Selection" Click="ClearSelection_Click"/>
      </MenuItem>

      <!-- View Menu -->
      <MenuItem Header="_View">
        <MenuItem Header="Scan _Recursively">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding IsRecursive}" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Inspector Panel" Command="{Binding ToggleInspectorCommand}">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding IsInspectorVisible}" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Theme">
          <MenuItem Header="_System Default" Click="ThemeSystem_Click">
            <MenuItem.Icon>
              <RadioButton IsChecked="{Binding IsThemeSystem}" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Dark Mode" Click="ThemeDark_Click">
            <MenuItem.Icon>
              <RadioButton IsChecked="{Binding IsThemeDark}" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Light Mode" Click="ThemeLight_Click">
            <MenuItem.Icon>
              <RadioButton IsChecked="{Binding IsThemeLight}" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Enable _Verbose / Debug Logging" Click="ToggleDebugLogging_Click">
          <MenuItem.Icon>
            <CheckBox Name="DebugLoggingMenuCheckBox" Click="ToggleDebugLogging_Click" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Refresh Grid" InputGesture="F5" Command="{Binding RefreshGridCommand}"/>
      </MenuItem>

      <!-- Tools Menu -->
      <MenuItem Header="_Tools">
        <MenuItem Header="🔍 _Auto-Tag Metadata (ComicVine)..." Click="ScrapeMetadata_Click"/>
        <MenuItem Header="🧙 Series _Search Wizard..." Click="SeriesSearchWizard_Click"/>
        <MenuItem Header="📚 _Bulk Auto-Tag Queue..." Click="BulkScrapeQueue_Click"/>
        <MenuItem Header="🏷️ _Infer Metadata from Path / Filename" Click="InferMetadataFromFilenames_Click"/>
        <MenuItem Header="✏️ _Rename File(s) from Metadata..." Click="RenameFiles_Click"/>
        <Separator/>
        <MenuItem Header="🌐 _Sync to Komga Server" Command="{Binding SyncToKomgaCommand}"/>
        <Separator/>
        <MenuItem Header="Open _Logs Directory" Command="{Binding OpenLogsCommand}"/>
        <MenuItem Header="_Settings..." Click="Settings_Click"/>
      </MenuItem>
      
      <!-- Help Menu -->
      <MenuItem Header="_Help">
        <MenuItem Header="_Check for Updates" Command="{Binding CheckForUpdatesCommand}"/>
        <MenuItem Header="Install &amp; Restart Update" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}"/>
        <Separator/>
        <MenuItem Header="_About InkTag Desktop" Click="OpenAbout_Click"/>
      </MenuItem>
    </Menu>

    <!-- Top Header Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource AppToolbarBrush}" Padding="8,6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
        <!-- Open Folder Button (Primary Call-to-Action) -->
        <Button Grid.Column="0" Click="OpenFolder_Click" Padding="14,6" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" CornerRadius="4" IsEnabled="{Binding !IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📁" VerticalAlignment="Center"/>
            <TextBlock Text="Open Folder..." VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>

        <!-- Save All Button (Neutral Outline) -->
        <Button Grid.Column="1" Classes="outline" Command="{Binding SaveAllCommand}" Margin="8,0,0,0" IsEnabled="{Binding !IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="💾" VerticalAlignment="Center"/>
            <TextBlock Text="Save All" VerticalAlignment="Center" FontWeight="Medium"/>
          </StackPanel>
        </Button>

        <!-- Separator -->
        <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="12,3"/>

        <!-- Scan Recursively CheckBox Toggle -->
        <CheckBox Grid.Column="3" IsChecked="{Binding IsRecursive}" Content="Scan Subfolders Recursively" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="{Binding !IsLoading}"/>

        <!-- Right Side Controls: Scrape, Refresh & Inspector Toggle (Neutral Outline Utilities) -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Click="ScrapeMetadata_Click" ToolTip.Tip="Auto-Tag metadata from ComicVine" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🌐" VerticalAlignment="Center"/>
              <TextBlock Text="Auto-Tag" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="outline" Click="BulkScrapeQueue_Click" ToolTip.Tip="Bulk Auto-Tag Queue" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="📚" VerticalAlignment="Center"/>
              <TextBlock Text="Bulk Auto-Tag" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="outline" Command="{Binding SyncToKomgaCommand}" ToolTip.Tip="Sync modified metadata &amp; refresh Komga server" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🌐" VerticalAlignment="Center"/>
              <TextBlock Text="Sync to Komga" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="outline" Command="{Binding RefreshGridCommand}" ToolTip.Tip="Refresh Grid (F5)" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🔄" VerticalAlignment="Center"/>
              <TextBlock Text="Refresh" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <ToggleButton Classes="outline" IsChecked="{Binding IsInspectorVisible}" ToolTip.Tip="Toggle Inspector Panel">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="📋" VerticalAlignment="Center"/>
              <TextBlock Text="Inspector" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Workspace Split Area -->
    <Grid Grid.Row="2" x:Name="MainWorkspaceGrid" ColumnDefinitions="*, Auto, 350">
      
      <!-- Left Column: Spreadsheet DataGrid -->
      <Grid Grid.Column="0" Margin="10" RowDefinitions="Auto, *">
        
        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,6">
          <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- Segmented Filter Pills Group -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Filter:" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
              
              <Border Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding AllFilterLabel}" IsChecked="{Binding IsFilterAll}"/>
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding UntaggedFilterLabel}" IsChecked="{Binding IsFilterUntagged}"/>
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding ModifiedFilterLabel}" IsChecked="{Binding IsFilterModified}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Quick Filter / Search Box -->
            <TextBox Grid.Column="1" Text="{Binding FilterSearchText}" 
                     Watermark="🔍 Filter list by file name, series, title, writer..." 
                     Margin="16,0" Padding="6,4" FontSize="11" Height="26"
                     Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" CornerRadius="3"/>

            <!-- Status Count Badge -->
            <TextBlock Grid.Column="2" Text="{Binding FilterStatusText}" 
                       Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
          </Grid>
        </Border>

        <!-- Comic DataGrid Table -->
        <DataGrid Grid.Row="1" Name="ComicsGrid" ItemsSource="{Binding DisplayedComics}" SelectedItem="{Binding ActiveComic}" 
                  SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True"
                  Background="{DynamicResource AppDataGridBackgroundBrush}" AutoGenerateColumns="False" 
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  SelectionChanged="DataGrid_SelectionChanged">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="🔍 Auto-Tag Metadata (ComicVine)..." Click="ScrapeMetadata_Click"/>
              <MenuItem Header="🧙 Series Search Wizard..." Click="SeriesSearchWizard_Click"/>
              <MenuItem Header="📚 Bulk Auto-Tag Selected..." Click="BulkScrapeQueue_Click"/>
              <Separator/>
              <MenuItem Header="🏷️ Infer Metadata from Path / Filename" Click="InferMetadataFromFilenames_Click"/>
              <MenuItem Header="✏️ Rename File(s) from Metadata..." Click="RenameFiles_Click"/>
              <Separator/>
              <MenuItem Header="🌐 Sync Selected with Komga" Command="{Binding SyncToKomgaCommand}"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Styles>
            <Style Selector="DataGridRow">
              <Setter Property="Background" Value="{Binding IsDirty, Converter={StaticResource IsDirtyToBrushConverter}}" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Untagged" Binding="{Binding IsUntagged}" IsReadOnly="True" Width="85"/>
            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" IsReadOnly="True" Width="200"/>
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180"/>
            <DataGridTextColumn Header="Series" Binding="{Binding Series}" Width="160"/>
            <DataGridTextColumn Header="Issue #" Binding="{Binding Number}" Width="80"/>
            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="75"/>
            <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="80"/>
            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140"/>
            <DataGridTextColumn Header="Imprint" Binding="{Binding Imprint}" Width="120"/>
            <DataGridTextColumn Header="Series Group" Binding="{Binding SeriesGroup}" Width="140"/>
            <DataGridTextColumn Header="Story Arc" Binding="{Binding StoryArc}" Width="140"/>
            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="75"/>
            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="80"/>
            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="75"/>
            <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="120"/>
            <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="140"/>
            <DataGridTextColumn Header="Writer" Binding="{Binding Writer}" Width="140"/>
            <DataGridTextColumn Header="Penciller" Binding="{Binding Penciller}" Width="140"/>
            <DataGridTextColumn Header="Inker" Binding="{Binding Inker}" Width="140"/>
            <DataGridTextColumn Header="Colorist" Binding="{Binding Colorist}" Width="140"/>
            <DataGridTextColumn Header="Letterer" Binding="{Binding Letterer}" Width="140"/>
            <DataGridTextColumn Header="Cover Artist" Binding="{Binding CoverArtist}" Width="140"/>
            <DataGridTextColumn Header="Editor" Binding="{Binding Editor}" Width="140"/>
            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="220"/>
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="180"/>
            <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="100"/>
            <DataGridTextColumn Header="Black &amp; White" Binding="{Binding BlackAndWhite}" Width="110"/>
            <DataGridTextColumn Header="Age Rating" Binding="{Binding AgeRating}" Width="100"/>
            <DataGridTextColumn Header="Language ISO" Binding="{Binding LanguageISO}" Width="100"/>
            <DataGridTextColumn Header="Page Count" Binding="{Binding PageCount}" Width="90"/>
            <DataGridTextColumn Header="Characters" Binding="{Binding Characters}" Width="160"/>
            <DataGridTextColumn Header="Teams" Binding="{Binding Teams}" Width="140"/>
            <DataGridTextColumn Header="Locations" Binding="{Binding Locations}" Width="140"/>
            <DataGridTextColumn Header="Scan Info" Binding="{Binding ScanInformation}" Width="160"/>
            <DataGridTextColumn Header="Web Link" Binding="{Binding Web}" Width="180"/>
            <DataGridCheckBoxColumn Header="Manga (RTL)" Binding="{Binding Manga}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Loading & Progress Overlay (Centered specifically over the DataGrid panel) -->
        <Border Grid.Row="1" IsVisible="{Binding IsLoading}" Background="{DynamicResource AppOverlayBackdropBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" BoxShadow="0 4 16 #80000000">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
              <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="6" Width="300" Foreground="{DynamicResource AppAccentBrush}"/>
              <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>

              <!-- Slow Network Share Warning Card -->
              <Border IsVisible="{Binding IsSlowShareWarningVisible}" Background="#3A2A18" BorderBrush="#E5A00D" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⚠️" FontSize="13"/>
                    <TextBlock Text="Slow Virtual Share Detected" FontWeight="Bold" Foreground="#FFD54F" FontSize="12"/>
                  </StackPanel>
                  <TextBlock Text="This remote mount does not support archive seeking and requires streaming complete files over the network. For instant performance, mount via SMB/CIFS."
                             FontSize="11" Foreground="#DDD" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Button Content="✕ Cancel Scan" Command="{Binding CancelScanCommand}"
                      Background="#C42B1C" Foreground="White" FontWeight="SemiBold" Padding="16,6" HorizontalAlignment="Center" CornerRadius="4"/>
            </StackPanel>
          </Border>
        </Border>
      </Grid>

      <!-- Splitter Column: GridSplitter between DataGrid and Inspector -->
      <GridSplitter Grid.Column="1" 
                    Width="6" 
                    Background="{DynamicResource AppBorderBrush}" 
                    ResizeDirection="Columns" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding IsInspectorVisible}" 
                    Focusable="False" 
                    ToolTip.Tip="Drag to resize Inspector panel"/>

      <!-- Right Column: Details & Bulk Tools Sidebar -->
      <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="15" IsVisible="{Binding IsInspectorVisible}">
        <TabControl Theme="{StaticResource {x:Type TabControl}}">
          
          <!-- Tab 1: Single Comic Inspector -->
          <TabItem Header="Details" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel Spacing="12">
                <Border Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="4" Padding="5" HorizontalAlignment="Center" Height="200" Width="150">
                  <Panel>
                    <TextBlock Text="No Cover" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding ActiveComic.CoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <Image Source="{Binding ActiveComic.CoverImage}" Stretch="Uniform" IsVisible="{Binding ActiveComic.CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </Panel>
                </Border>

                <StackPanel Spacing="5" IsVisible="{Binding ActiveComic, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="File Name" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                  <TextBox Text="{Binding ActiveComic.FileName}" IsReadOnly="True" Background="{DynamicResource AppInputBackgroundBrush}" BorderThickness="1"/>
                  
                  <TextBlock Text="Title" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Title}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Series" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Series}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <Grid ColumnDefinitions="*, *" Margin="0,5,0,0" KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                      <TextBlock Text="Issue (Number)" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Number}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                      <TextBlock Text="Volume" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Volume}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="Publisher" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Publisher}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <Grid ColumnDefinitions="*, *" Margin="0,5,0,0" KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                      <TextBlock Text="Year" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Year}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                      <TextBlock Text="Month" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Month}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="Writer" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Writer}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Genre" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Genre}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Tags (Comma separated)" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Tags}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Language ISO" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.LanguageISO}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <CheckBox Content="Manga (Read Right-to-Left)" IsChecked="{Binding ActiveComic.Manga}" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock Text="Select a comic to view details" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" Margin="0,50,0,0" IsVisible="{Binding ActiveComic, Converter={x:Static ObjectConverters.IsNull}}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          
          <!-- Tab 2: Bulk Apply Tools -->
          <TabItem Header="Bulk Edit" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel Spacing="12">
                <TextBlock Text="Modify selected rows in batch:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,5"/>

                <ItemsControl ItemsSource="{Binding BulkEditRules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BulkEditRuleViewModel">
                      <Border Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <!-- Row Header: Field & Operation -->
                          <Grid ColumnDefinitions="*, *, Auto">
                            <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding SelectedField}" Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkEditFieldInfo">
                                  <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding AvailableOperations}" SelectedItem="{Binding SelectedOperation}" Grid.Column="1" Margin="4,0,4,0" HorizontalAlignment="Stretch"/>
                            <Button Content="✕" Command="{Binding $parent[Window].DataContext.RemoveBulkRuleCommand}" CommandParameter="{Binding .}" Grid.Column="2" Padding="6,2" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" ToolTip.Tip="Remove Rule"/>
                          </Grid>

                          <!-- Context-Sensitive Inputs -->
                          <!-- String Text Editor -->
                          <TextBox Text="{Binding StringValue}" Watermark="New Value" IsVisible="{Binding IsTextEditorVisible}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                          <!-- Numeric Editor -->
                          <NumericUpDown Value="{Binding NumericValue}" IsVisible="{Binding IsNumericEditorVisible}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                          <!-- Enum Selector -->
                          <ComboBox ItemsSource="{Binding EnumOptions}" SelectedItem="{Binding SelectedEnumOption}" IsVisible="{Binding IsEnumEditorVisible}" HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBackgroundBrush}"/>

                          <!-- Find & Replace Pair -->
                          <Grid ColumnDefinitions="*, *" IsVisible="{Binding IsReplaceEditorVisible}">
                            <TextBox Text="{Binding FindValue}" Watermark="Find..." Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource AppInputBackgroundBrush}"/>
                            <TextBox Text="{Binding ReplaceValue}" Watermark="Replace with..." Grid.Column="1" Margin="4,0,0,0" Background="{DynamicResource AppInputBackgroundBrush}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Core Details Group -->
                <TextBlock Text="Core Information" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"/>
                <TextBlock Text="Title" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <TextBox Text="{Binding ActiveComic.Title}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Series" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Series}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Grid ColumnDefinitions="*, *, *">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Issue #" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Number}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="2,0,2,0">
                    <TextBlock Text="Count" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Count}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="Volume" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Volume}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Publisher" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Publisher}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Imprint" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Imprint}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Series Group" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.SeriesGroup}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Story Arc" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.StoryArc}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Grid ColumnDefinitions="*, *, *" Margin="0,5,0,0">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Year" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Year}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="2,0,2,0">
                    <TextBlock Text="Month" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Month}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="Day" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Day}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <!-- Creators Group -->
                <TextBlock Text="Creators" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12" Margin="0,10,0,0"/>
                
                <TextBlock Text="Writer" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <TextBox Text="{Binding ActiveComic.Writer}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Penciller" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Penciller}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Inker" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Inker}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Colorist" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Colorist}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Letterer" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Letterer}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Cover Artist" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.CoverArtist}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Editor" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Editor}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <!-- Content & Classification -->
                <TextBlock Text="Content &amp; Classification" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12" Margin="0,10,0,0"/>

                <TextBlock Text="Summary" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <TextBox Text="{Binding ActiveComic.Summary}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Genre" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Genre}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Tags" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Tags}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Notes" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Notes}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Format" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Format}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Age Rating" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.AgeRating}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Language ISO" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.LanguageISO}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Page Count" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.PageCount}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Characters" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Characters}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Teams" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Teams}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Locations" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Locations}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Scan Info" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.ScanInformation}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Web Link" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Web}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <CheckBox IsChecked="{Binding ActiveComic.BlackAndWhite}" Content="Black &amp; White" Margin="0,5,0,0"/>
                <CheckBox IsChecked="{Binding ActiveComic.Manga}" Content="Manga (Right-to-Left)" Margin="0,2,0,10"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- TAB 2: Multi-Item Bulk Tools -->
          <TabItem Header="Bulk Tools" FontSize="12">
            <StackPanel Spacing="8" Margin="10">
              <TextBlock Text="Bulk Edit Controls" FontWeight="Bold" FontSize="14" Foreground="#3592FF" Margin="0,0,0,5"/>

              <CheckBox IsChecked="{Binding BulkSeriesEnabled}" Content="Set Series"/>
              <TextBox Text="{Binding BulkSeries}" IsEnabled="{Binding BulkSeriesEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <CheckBox IsChecked="{Binding BulkPublisherEnabled}" Content="Set Publisher" Margin="0,5,0,0"/>
              <TextBox Text="{Binding BulkPublisher}" IsEnabled="{Binding BulkPublisherEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <CheckBox IsChecked="{Binding BulkYearEnabled}" Content="Set Year" Margin="0,5,0,0"/>
              <TextBox Text="{Binding BulkYear}" IsEnabled="{Binding BulkYearEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <CheckBox IsChecked="{Binding BulkGenreEnabled}" Content="Set Genre" Margin="0,5,0,0"/>
              <TextBox Text="{Binding BulkGenre}" IsEnabled="{Binding BulkGenreEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <CheckBox IsChecked="{Binding BulkMangaEnabled}" Content="Set Manga Direction" Margin="0,5,0,0"/>
              <ComboBox ItemsSource="{Binding MangaOptions}" SelectedItem="{Binding BulkManga}" IsEnabled="{Binding BulkMangaEnabled}" HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <Button Content="Apply to Selected / All" Command="{Binding BulkApplyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0" Padding="10" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}"/>
              <TextBlock Text="Tip: Applies only to selected rows, or all rows if none are highlighted." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

              <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,10"/>

              <TextBlock Text="Find &amp; Replace" FontWeight="Bold" FontSize="14" Foreground="#3592FF"/>

              <TextBlock Text="Target Column" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
              <ComboBox ItemsSource="{Binding ReplaceColumns}" SelectedItem="{Binding SelectedReplaceColumn}" HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <TextBlock Text="Find text" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
              <TextBox Text="{Binding FindText}" Watermark="e.g. Vol 1" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <TextBlock Text="Replace with" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
              <TextBox Text="{Binding ReplaceText}" Watermark="e.g. Volume 1" Background="{DynamicResource AppInputBackgroundBrush}"/>

              <Button Content="Execute Replace" Command="{Binding FindReplaceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0" Padding="10" Background="#0E639C" Foreground="White"/>
              <TextBlock Text="Tip: Applies only to selected rows, or all rows if none are highlighted." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
          </TabItem>
          
        </TabControl>
      </Border>
    </Grid>

    <!-- Bottom Soft Framed Status Bar -->
    <Border Grid.Row="3" Background="{DynamicResource AppStatusBarBackgroundBrush}" BorderBrush="{DynamicResource AppStatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
      <Grid ColumnDefinitions="Auto, Auto, *, Auto">
        <!-- Loaded File Count & Active Folder Breadcrumb -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Comics.Count, StringFormat='{}{0} files loaded'}" Foreground="{DynamicResource AppStatusBarForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>

          <TextBlock Text="•" Foreground="{DynamicResource AppStatusBarMutedBrush}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasSelectedDirectory}"/>
          <TextBlock Text="{Binding SelectedDirectory, StringFormat='📁 {0}'}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                     Foreground="{DynamicResource AppStatusBarMutedBrush}" VerticalAlignment="Center" FontSize="11" ToolTip.Tip="{Binding SelectedDirectory}"
                     IsVisible="{Binding HasSelectedDirectory}"/>
        </StackPanel>

        <!-- Progress Tracker in Status Bar -->
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
          <Rectangle Width="1" Fill="{DynamicResource AppStatusBarBorderBrush}" Height="12" VerticalAlignment="Center"/>
          
          <!-- Animated Progress Bar -->
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Width="120" Height="6" CornerRadius="3"
                       IsVisible="{Binding IsLoading}" VerticalAlignment="Center"
                       Background="{DynamicResource AppBorderBrush}" Foreground="{DynamicResource AppAccentBrush}"/>
          
          <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AppStatusBarMutedBrush}" VerticalAlignment="Center" FontSize="11"/>

          <!-- Cancel Scan Button -->
          <Button Classes="outline" Command="{Binding CancelScanCommand}" Content="✕ Cancel" IsVisible="{Binding IsLoading}"
                  Padding="6,2" FontSize="11" CornerRadius="3"
                  VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Update Status Text -->
        <TextBlock Grid.Column="2" Text="{Binding UpdateStatusText}" Foreground="{DynamicResource AppStatusBarMutedBrush}" VerticalAlignment="Center" FontSize="11" HorizontalAlignment="Right" Margin="0,0,15,0"/>

        <!-- Version Label -->
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource AppStatusBarMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
