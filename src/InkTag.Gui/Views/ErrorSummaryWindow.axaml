<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InkTag.Gui.Views.ErrorSummaryWindow"
        Title="Save Errors Summary"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">
  <Grid RowDefinitions="Auto, *, Auto" Margin="20">
    <TextBlock Text="The following errors occurred while saving:" FontWeight="Bold" FontSize="16" Grid.Row="0" Margin="0,0,0,10"/>
    <ListBox Name="ErrorsListBox" Grid.Row="1" Background="#1E1E1E">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="5">
            <TextBlock Text="{Binding Path}" FontWeight="Bold" Foreground="Red" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="10,2,0,0"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Content="Close" Click="CloseClick" Grid.Row="2" HorizontalAlignment="Right" Width="80" Margin="0,15,0,0"/>
  </Grid>
</Window>
