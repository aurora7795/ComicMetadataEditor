<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InkTag.Gui.Views.SettingsWindow"
        Title="InkTag Settings"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E1E" Foreground="White">

  <Border Padding="20">
    <Grid RowDefinitions="*, Auto">
      <StackPanel Grid.Row="0" Spacing="15">
        <TextBlock Text="⚙️ InkTag Configuration" FontSize="18" FontWeight="Bold" Foreground="#3592FF"/>
        <Separator Background="#3F3F46"/>

        <!-- ComicVine API Key -->
        <StackPanel Spacing="5">
          <TextBlock Text="ComicVine API Key:" FontWeight="Medium"/>
          <Grid ColumnDefinitions="*, Auto">
            <TextBox Name="ApiKeyTextBox" Grid.Column="0" PasswordChar="•" Watermark="Enter your ComicVine API key..."/>
            <Button Grid.Column="1" Content="Test Key" Click="TestApiKey_Click" Padding="12,6" Background="#2D2D30" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock Name="StatusTextBlock" Text="" FontSize="11" Foreground="Gray"/>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Get a free key at" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            <Button Content="https://comicvine.gamespot.com/api/" Click="OpenApiUrl_Click" Classes="linkButton" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <!-- Default Merge Policy -->
        <StackPanel Spacing="5" Margin="0,10,0,0">
          <TextBlock Text="Default Scraper Merge Policy:" FontWeight="Medium"/>
          <ComboBox Name="MergePolicyComboBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Fill Missing Only (Preserve Existing Edits)"/>
            <ComboBoxItem Content="Overwrite All Fields"/>
          </ComboBox>
        </StackPanel>

        <!-- Visual Cover Match Options -->
        <StackPanel Spacing="5" Margin="0,10,0,0">
          <TextBlock Text="Cover Image Matching (Perceptual Hashing):" FontWeight="Medium"/>
          <CheckBox Name="VisualMatchCheckBox" Content="Enable automated cover matching &amp; visual verification" IsChecked="True"/>
          <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
            <TextBlock Grid.Column="0" Text="Visual Match Confidence Threshold (Default 90%):" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
            <TextBox Name="VisualThresholdTextBox" Grid.Column="1" Text="90" Width="60" TextAlignment="Center"/>
          </Grid>
        </StackPanel>

        <!-- Cache Management -->
        <StackPanel Spacing="5" Margin="0,10,0,0">
          <TextBlock Text="Local Response Cache:" FontWeight="Medium"/>
          <Grid ColumnDefinitions="*, Auto">
            <TextBlock Grid.Column="0" Text="Response &amp; cover hash cache (~/.cache/InkTag/scraper_cache.json)" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
            <Button Grid.Column="1" Content="Clear Cache" Click="ClearCache_Click" Padding="10,5" Background="#3E3E42"/>
          </Grid>
        </StackPanel>
      </StackPanel>

      <!-- Action Buttons -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
        <Button Content="Cancel" Click="Cancel_Click" Padding="15,6" Background="#2D2D30"/>
        <Button Content="Save Settings" Click="Save_Click" Padding="15,6" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
      </StackPanel>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.linkButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#569CD6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.linkButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="TextBlock.Foreground" Value="#9CDCFE"/>
      <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
    </Style>
  </Window.Styles>
</Window>
