<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InkTag.Gui.Views.ScraperMatchWindow"
        Title="ComicVine Auto-Tag Match &amp; Diff Viewer - InkTag"
        Width="950" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

  <Border Padding="15">
    <Grid RowDefinitions="Auto, *, Auto">
      
      <!-- Top Search Header -->
      <Border Grid.Row="0" Background="{DynamicResource AppCardBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="*, 100, 100, Auto, Auto">
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Series Title:" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
            <TextBox Name="SeriesTextBox" Watermark="Series..." Background="{DynamicResource AppInputBackgroundBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="Issue #:" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
            <TextBox Name="IssueTextBox" Watermark="Issue #..." Background="{DynamicResource AppInputBackgroundBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Margin="0,0,10,0">
            <TextBlock Text="Year:" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
            <TextBox Name="YearTextBox" Watermark="Year..." Background="{DynamicResource AppInputBackgroundBrush}"/>
          </StackPanel>

          <Button Name="SearchButton" Grid.Column="3" Content="🔍 Search" Click="Search_Click" VerticalAlignment="Bottom" Padding="15,7" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" FontWeight="Bold"/>
          <Button Name="SeriesWizardButton" Grid.Column="4" Content="🧙 Series Wizard..." Click="SeriesWizard_Click" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="12,7" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        </Grid>
      </Border>

      <!-- Main Workspace: Candidate Selection (Left) & Field Diff Viewer (Right) -->
      <Grid Grid.Row="1" ColumnDefinitions="400, 8, *">
        
        <!-- Left: Search Results List -->
        <Border Grid.Column="0" Background="{DynamicResource AppCardBrush}" CornerRadius="4" Padding="10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto, *">
            <TextBlock Grid.Row="0" Text="Candidate Results (ComicVine)" FontWeight="Bold" Margin="0,0,0,8" Foreground="#3592FF"/>
            <ListBox Name="CandidatesListBox" Grid.Row="1" SelectionChanged="CandidatesListBox_SelectionChanged" Background="{DynamicResource AppInputBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *">
                      <!-- Cover Thumbnail Image with Hover Preview -->
                      <Border Grid.Column="0" Width="50" Height="75" Background="{DynamicResource AppCardBrush}" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center"
                              ToolTip.ShowDelay="100">
                        <ToolTip.Tip>
                          <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" MaxWidth="300">
                            <StackPanel Spacing="6">
                              <Image Source="{Binding Thumbnail}" Height="350" Stretch="Uniform"
                                     IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                              <TextBlock Text="No Cover Image Available" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="10"
                                         IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                              <TextBlock Text="{Binding SeriesTitle}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding IssueTitle}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </ToolTip.Tip>
                        <Panel>
                          <TextBlock Text="No Cover" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                     IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                 IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Panel>
                      </Border>

                      <!-- Candidate Info Details -->
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SeriesTitle}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding IssueTitle}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   IsVisible="{Binding IssueTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                          <TextBlock Text="{Binding IssueNumber, StringFormat='Issue #{0}'}" FontSize="11" Foreground="#3592FF" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding CoverDate}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                        <!-- Perceptual Hash Match Badge -->
                        <Border Background="#123B22" BorderBrush="#107C41" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,4,0,0"
                                HorizontalAlignment="Left" IsVisible="{Binding HasVisualMatchBadge}">
                          <TextBlock Text="{Binding VisualSimilarityBadge}" FontSize="10" Foreground="#4EC9B0" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- Splitter Column -->
        <GridSplitter Grid.Column="1" Background="{DynamicResource AppBorderBrush}" HorizontalAlignment="Stretch"/>

        <!-- Right: Field Diff Comparison Viewer -->
        <Border Grid.Column="2" Background="{DynamicResource AppCardBrush}" CornerRadius="4" Padding="10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto, Auto, *">
            
            <!-- Side-by-Side Cover Preview Card -->
            <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*, Auto, *">
                
                <!-- Left: Local File Cover -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="Current Local Cover" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                  <Border Width="65" Height="95" Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="4" ClipToBounds="True"
                          ToolTip.ShowDelay="100">
                    <ToolTip.Tip>
                      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" MaxWidth="300">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Local Archive Cover" FontSize="12" FontWeight="Bold" Foreground="#4EC9B0" HorizontalAlignment="Center"/>
                          <Image Source="{Binding LocalCoverImage}" Height="375" Width="250" Stretch="Uniform"
                                 IsVisible="{Binding LocalCoverImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          <TextBlock Text="No Local Cover Available" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="10"
                                     IsVisible="{Binding LocalCoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </StackPanel>
                      </Border>
                    </ToolTip.Tip>
                    <Panel>
                      <TextBlock Text="No Cover" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding LocalCoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                      <Image Source="{Binding LocalCoverImage}" Stretch="Uniform"
                             IsVisible="{Binding LocalCoverImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Panel>
                  </Border>
                  <!-- Page Navigation Controls -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,2,0,0">
                    <Button Content="◀" Click="PrevPage_Click" Padding="6,1" FontSize="10" Background="#2D2D30" Foreground="White"
                            ToolTip.Tip="Previous Page"/>
                    <TextBlock Text="{Binding PageDisplayStatus}" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Content="▶" Click="NextPage_Click" Padding="6,1" FontSize="10" Background="#2D2D30" Foreground="White"
                            ToolTip.Tip="Next Page"/>
                  </StackPanel>
                </StackPanel>

                <!-- Center: Comparison Status / Match Indicator -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0" Spacing="4">
                  <TextBlock Text="➔" FontSize="16" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                  <Border Background="#123B22" BorderBrush="#107C41" BorderThickness="1" CornerRadius="3" Padding="4,2"
                          IsVisible="{Binding IsCoverMatchConfirmed}">
                    <TextBlock Text="MATCH" FontSize="9" Foreground="#4EC9B0" FontWeight="Bold" HorizontalAlignment="Center"/>
                  </Border>
                </StackPanel>

                <!-- Right: Selected Candidate Remote Cover -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="ComicVine Cover" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                  <Border Width="65" Height="95" Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="4" ClipToBounds="True"
                          ToolTip.ShowDelay="100">
                    <ToolTip.Tip>
                      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" MaxWidth="300">
                        <StackPanel Spacing="6">
                          <TextBlock Text="ComicVine API Cover" FontSize="12" FontWeight="Bold" Foreground="#3592FF" HorizontalAlignment="Center"/>
                          <Image Source="{Binding SelectedCandidateThumbnail}" Height="375" Width="250" Stretch="Uniform"
                                 IsVisible="{Binding SelectedCandidateThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          <TextBlock Text="Select a Candidate Result" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextAlignment="Center" Margin="10"
                                     IsVisible="{Binding SelectedCandidateThumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </StackPanel>
                      </Border>
                    </ToolTip.Tip>
                    <Panel>
                      <TextBlock Text="Select Candidate" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                 IsVisible="{Binding SelectedCandidateThumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                      <Image Source="{Binding SelectedCandidateThumbnail}" Stretch="Uniform"
                             IsVisible="{Binding SelectedCandidateThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Panel>
                  </Border>
                </StackPanel>

              </Grid>
            </Border>

            <!-- Diff Controls Header -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="Field-by-Field Diff Comparison" FontWeight="Bold" Foreground="#3592FF"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Select All" Click="SelectAllFields_Click" Padding="6,2" FontSize="11" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <Button Content="Select None" Click="SelectNoFields_Click" Padding="6,2" FontSize="11" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- Diff Table -->
            <DataGrid Name="DiffDataGrid" Grid.Row="2" AutoGenerateColumns="False" GridLinesVisibility="All" Background="{DynamicResource AppDataGridBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IsSelected}" Width="60"/>
                <DataGridTextColumn Header="Field Name" Binding="{Binding FieldName}" IsReadOnly="True" Width="110" FontWeight="Bold"/>

                <!-- Local Value Column with ToolTip -->
                <DataGridTemplateColumn Header="Local Value" Width="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding LocalValue}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LocalValue}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Online Value Column with ToolTip -->
                <DataGridTemplateColumn Header="Online Value (ComicVine)" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding OnlineValue}" Foreground="#3592FF" VerticalAlignment="Center" Margin="8,0"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OnlineValue}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <!-- Bottom Action Bar -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,0">
        <CheckBox Name="RemoveIntroPageCheckBox" Grid.Column="0" Content="Remove provider intro page (00.jpg) on apply"
                  VerticalAlignment="Center" Foreground="#E0AF68" FontSize="12"
                  ToolTip.Tip="Strips the first page from the archive if it is a scanner/provider intro or advert page."/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button Content="Cancel" Click="Cancel_Click" Padding="15,6" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
          <Button Content="Overwrite All" Click="OverwriteAll_Click" Padding="15,6" Background="#D83B01" Foreground="White" FontWeight="Bold"/>
          <Button Content="Apply Selected Fields" Click="ApplySelected_Click" Padding="15,6" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" FontWeight="Bold"/>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
