<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InkTag.Gui.Views.PromptWindow"
        Title="Unsaved Changes"
        Width="420" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="*, Auto" Margin="20">
    <TextBlock Text="You have unsaved changes. Would you like to save them before exiting?" 
               TextWrapping="Wrap" Grid.Row="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Save" Click="SaveClick" Width="85" HorizontalContentAlignment="Center" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}"/>
      <Button Content="Discard" Click="DiscardClick" Width="85" HorizontalContentAlignment="Center" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
      <Button Content="Cancel" Click="CancelClick" Width="85" HorizontalContentAlignment="Center" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
    </StackPanel>
  </Grid>
</Window>
