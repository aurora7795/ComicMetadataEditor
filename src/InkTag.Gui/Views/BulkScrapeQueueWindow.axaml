<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InkTag.Gui.ViewModels"
        x:Class="InkTag.Gui.Views.BulkScrapeQueueWindow"
        x:DataType="vm:BulkScrapeQueueViewModel"
        Title="Bulk Auto-Tag &amp; Cover Identification Queue - InkTag"
        Width="1180" Height="700"
        MinWidth="960" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

  <Border Padding="16">
    <Grid RowDefinitions="Auto, *, Auto">
      
      <!-- Top Control & Status Dashboard -->
      <Border Grid.Row="0" Background="{DynamicResource AppCardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto, Auto">
          
          <!-- Summary Metrics & Actions Bar -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
            
            <!-- Metric Chips -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Background="{DynamicResource AppButtonSecondaryBrush}" CornerRadius="4" Padding="8,5">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="Total:" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11.5"/>
                  <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11.5"/>
                </StackPanel>
              </Border>

              <Border Background="#123B22" CornerRadius="4" Padding="8,5">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="🟢 Matched:" Foreground="#4EC9B0" FontSize="11.5"/>
                  <TextBlock Text="{Binding MatchedCount}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="11.5"/>
                </StackPanel>
              </Border>

              <Border Background="#3B2E12" CornerRadius="4" Padding="8,5">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="🟡 Review:" Foreground="#FFCC00" FontSize="11.5"/>
                  <TextBlock Text="{Binding ReviewNeededCount}" FontWeight="Bold" Foreground="#FFCC00" FontSize="11.5"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource AppButtonSecondaryBrush}" CornerRadius="4" Padding="8,5">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="⚪ Unmatched:" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11.5"/>
                  <TextBlock Text="{Binding UnmatchedCount}" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11.5"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Mode & Process Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Policy:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11.5"/>
              <ComboBox SelectedIndex="{Binding SelectedMergeModeIndex}" IsEnabled="{Binding CanStart}" Width="150" ToolTip.Tip="Controls whether scraping fills in missing metadata only or overwrites all fields.">
                <ComboBoxItem Content="Fill Missing Only"/>
                <ComboBoxItem Content="Overwrite All Fields"/>
              </ComboBox>

              <Button Name="StartQueueButton" Content="▶ Start Auto-Tag" Click="StartQueue_Click"
                      IsEnabled="{Binding CanStart}" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" FontWeight="Bold" Padding="12,7" CornerRadius="4"/>

              <Button Name="CancelQueueButton" Content="⏹ Cancel" Click="CancelQueue_Click"
                      IsEnabled="{Binding IsRunning}" Background="#A80000" Foreground="White" Padding="10,7" CornerRadius="4"/>
            </StackPanel>
          </Grid>

          <!-- Progress Bar & Status Line -->
          <Grid Grid.Row="1" RowDefinitions="Auto, Auto" Margin="0,12,0,0">
            <ProgressBar Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="6" CornerRadius="3"
                         Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Text="{Binding ProgressStatus}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </Grid>

          <!-- Batch Completion Banner -->
          <Border Grid.Row="2" Background="#123B22" BorderBrush="#107C41" BorderThickness="1" CornerRadius="4"
                  Padding="10,6" Margin="0,6,0,0" IsVisible="{Binding IsSuccessBannerVisible}">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Grid.Column="0" Text="{Binding SuccessBannerMessage}" Foreground="#4EC9B0" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="✓ Return to Grid" Click="Close_Click" Padding="12,5" Background="#107C41" Foreground="White" CornerRadius="3"/>
            </Grid>
          </Border>

        </Grid>
      </Border>

      <!-- Main Queue DataGrid -->
      <Border Grid.Row="1" Background="{DynamicResource AppCardBrush}" CornerRadius="6" Padding="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <DataGrid Name="QueueDataGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  SelectionMode="Extended" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="{DynamicResource AppDataGridBackgroundBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" KeyDown="QueueDataGrid_KeyDown">

          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Include Highlighted Items (Check)" Click="IncludeSelected_Click" InputGesture="Space"/>
              <MenuItem Header="Exclude Highlighted Items (Uncheck)" Click="ExcludeSelected_Click"/>
              <MenuItem Header="Toggle Checked State" Click="ToggleSelected_Click"/>
              <Separator/>
              <MenuItem Header="Select All" Click="SelectAll_Click"/>
              <MenuItem Header="Deselect All" Click="DeselectAll_Click"/>
              <Separator/>
              <MenuItem Header="Tweak Match..." Click="ContextTweakMatch_Click"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
          
          <DataGrid.Columns>
            
            <!-- Checkbox Selection -->
            <DataGridTemplateColumn Header="Include" Width="65">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <CheckBox IsChecked="{Binding IsSelected}" Click="ItemCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Status Badge Column -->
            <DataGridTemplateColumn Header="Status" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <Border Background="{Binding StatusBadgeBackground}" CornerRadius="3" Padding="6,3"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Local Cover Thumbnail -->
            <DataGridTemplateColumn Header="Local Cover" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <Border Width="40" Height="58" Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="3" ClipToBounds="True" Margin="4"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.ShowDelay="100">
                    <ToolTip.Tip>
                      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" MaxWidth="280">
                        <StackPanel Spacing="6">
                          <Image Source="{Binding LocalThumbnail}" Height="320" Stretch="Uniform"
                                 IsVisible="{Binding LocalThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          <TextBlock Text="No Cover Extracted" Foreground="Gray" HorizontalAlignment="Center"
                                     IsVisible="{Binding LocalThumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                          <TextBlock Text="{Binding Filename}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="10"/>
                        </StackPanel>
                      </Border>
                    </ToolTip.Tip>
                    <Image Source="{Binding LocalThumbnail}" Stretch="UniformToFill"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Archive File & Parsed Query -->
            <DataGridTemplateColumn Header="Archive File / Detected Query" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Border IsVisible="{Binding IsCbr}"
                              Background="#3D2800"
                              BorderBrush="#B87700"
                              BorderThickness="1"
                              CornerRadius="3"
                              Padding="5,1"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{Binding FormatConversionTooltip}">
                        <TextBlock Text="{Binding FormatBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFAA00" VerticalAlignment="Center"/>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                      <TextBlock Text="{Binding ParsedQueryText}" FontSize="11" Foreground="#569CD6"/>
                      <Border Background="#8A5A1A" CornerRadius="3" Padding="4,1" IsVisible="{Binding HasIntroPageBadge}">
                        <TextBlock Text="Page 2 Cover" FontSize="9" FontWeight="Bold" Foreground="#FFD8A8"/>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Matched ComicVine Series & Issue Title -->
            <DataGridTemplateColumn Header="ComicVine Match" Width="1.4*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding MatchedSeriesName}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MatchedIssueTitle}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Remote ComicVine Cover Thumbnail -->
            <DataGridTemplateColumn Header="Remote Cover" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <Border Width="40" Height="58" Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="3" ClipToBounds="True" Margin="4"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.ShowDelay="100">
                    <ToolTip.Tip>
                      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" MaxWidth="280">
                        <StackPanel Spacing="6">
                          <Image Source="{Binding RemoteThumbnail}" Height="320" Stretch="Uniform"
                                 IsVisible="{Binding RemoteThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          <TextBlock Text="No Cover" Foreground="Gray" HorizontalAlignment="Center"
                                     IsVisible="{Binding RemoteThumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                          <TextBlock Text="{Binding MatchedSeriesName}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding MatchedIssueTitle}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="10"/>
                        </StackPanel>
                      </Border>
                    </ToolTip.Tip>
                    <Image Source="{Binding RemoteThumbnail}" Stretch="UniformToFill"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Match Confidence Meter -->
            <DataGridTemplateColumn Header="Confidence" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2"
                              ToolTip.Tip="{Binding ConfidenceTooltip}">
                    <TextBlock Text="{Binding ConfidencePercentage}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding ConfidenceColor}" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding ConfidenceScore}" Minimum="0" Maximum="1" Height="3" Width="60"
                                 Foreground="{Binding ConfidenceColor}" Background="{DynamicResource AppBorderBrush}"
                                 IsVisible="{Binding HasMatch}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Visual Similarity Badge -->
            <DataGridTemplateColumn Header="Cover Match" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <Border Background="{Binding VisualBadgeBackground}" CornerRadius="3" Padding="6,2"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding VisualMatchTooltip}">
                    <TextBlock Text="{Binding VisualMatchLabel}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding VisualBadgeForeground}" HorizontalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Change Match Action -->
            <DataGridTemplateColumn Header="Action" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:BulkScrapeItemViewModel">
                  <Button Content="Tweak..." Click="ChangeMatch_Click" Padding="8,4" CornerRadius="4"
                          Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Bottom Confirmation Actions Bar -->
      <Border Grid.Row="2" Background="{DynamicResource AppCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto">
          
          <CheckBox Grid.Column="0" Content="Select / Deselect All" IsChecked="{Binding SelectAll}" VerticalAlignment="Center"/>

          <CheckBox Grid.Column="1" Content="Rename Files from Metadata" IsChecked="{Binding AlsoRenameFiles}"
                    VerticalAlignment="Center" Margin="24,0,10,0"/>

          <ComboBox Grid.Column="2" ItemsSource="{Binding RenameTemplates}" SelectedIndex="{Binding SelectedRenameTemplateIndex}"
                    IsVisible="{Binding AlsoRenameFiles}" VerticalAlignment="Center" MaxWidth="280"
                    Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" Margin="0,0,10,0"/>

          <CheckBox Grid.Column="3" Content="Strip Detected Intro Pages" IsChecked="{Binding StripDetectedIntroPages}"
                    VerticalAlignment="Center" Margin="10,0,10,0" Foreground="#E0AF68"
                    ToolTip.Tip="Automatically removes provider/scanner intro pages from comic archives where cover art was detected on page 2."/>

          <Button Name="ApplyButton" Grid.Column="4" Content="{Binding ApplyButtonText}" Click="ApplyMatched_Click"
                  IsEnabled="{Binding CanApply}" Background="{Binding ApplyButtonBackground}" Foreground="White" FontWeight="Bold" Padding="16,9" CornerRadius="4" Margin="0,0,10,0"/>

          <Button Grid.Column="5" Content="Close" Click="Close_Click" Padding="14,9" CornerRadius="4" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
