<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.11.0</Version>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAvalonia>true</UseAvalonia>
    <ApplicationIcon>Assets/inktag.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../InkTag.Core/InkTag.Core.csproj" />
  </ItemGroup>

  <!-- Assemble macOS .app bundle for local development on macOS -->
  <Target Name="AssembleMacAppBundle" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <AppBundleDir>$(TargetDir)InkTag.app</AppBundleDir>
    </PropertyGroup>
    <MakeDir Directories="$(AppBundleDir)/Contents/MacOS;$(AppBundleDir)/Contents/Resources" />
    <Copy SourceFiles="$(TargetDir)$(TargetName)" DestinationFolder="$(AppBundleDir)/Contents/MacOS" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(AppBundleDir)/Contents/MacOS" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).runtimeconfig.json" DestinationFolder="$(AppBundleDir)/Contents/MacOS" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)../../packaging/Info.plist" DestinationFolder="$(AppBundleDir)/Contents" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)../../packaging/InkTag.icns" DestinationFolder="$(AppBundleDir)/Contents/Resources" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(AppBundleDir)/Contents/MacOS/$(TargetName)&quot;" />
  </Target>
</Project>
